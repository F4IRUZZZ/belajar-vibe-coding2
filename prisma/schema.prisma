// PostgreSQL untuk dev & produksi (migrasi dari SQLite).
// Model diadaptasi dari schema.sql + schema-keuangan.sql (MySQL) di repo lama.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JenisTransaksi {
  masuk
  keluar
}

enum ArahHutang {
  hutang
  piutang
}

enum StatusHutang {
  belum
  lunas
}

enum Role {
  pribadi
  keluarga
}

// Akun: 1 email dipakai rame-rame serumah (role keluarga) atau sendiri (pribadi).
// Email/username disimpan apa adanya + versi lower untuk unik case-insensitive.
model User {
  id            String    @id @default(cuid())
  email         String
  emailLower    String    @unique
  username      String
  usernameLower String    @unique
  passwordHash  String
  role          Role      @default(keluarga)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
}

// 1 user = 1 sesi aktif (login baru menghanguskan sesi lama).
model Session {
  token     String   @id // random 32 byte hex, dibuat di kode
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Produk {
  id        String   @id @default(cuid())
  userId    String? // NULL = master shared global (mode single-tenant hari ini)
  nama      String
  namaLower String   @unique // unik case-insensitive
  kategori  String   @default("Lainnya")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaksi Transaksi[]

  @@index([userId])
}

model Transaksi {
  id        String         @id @default(cuid())
  userId    String // pemilik baris (Fase 2, backfill dari NULL)
  jenis     JenisTransaksi
  jumlah    Int // Rupiah murni (integer, tanpa sen)
  hargaSatuan Int? // Harga per unit saat beli (opsional, khusus keluar + produk)
  tanggal   DateTime
  kategori  String
  produkId  String?
  produk    Produk?        @relation(fields: [produkId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  catatan Catatan[]
  hutangLunas Hutang[] @relation("HutangLunas")

  @@index([jenis, tanggal])
  @@index([kategori])
  @@index([userId])
}

model Catatan {
  id          String    @id @default(cuid())
  transaksiId String
  transaksi   Transaksi @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  isi         String
  createdAt   DateTime  @default(now())

  @@index([transaksiId])
}

model Hutang {
  id               String        @id @default(cuid())
  userId           String // pemilik baris (Fase 2, backfill dari NULL)
  arah             ArahHutang
  pihak            String
  jumlah           Int
  dibayar          Int           @default(0)
  tanggal          DateTime
  jatuhTempo       DateTime?
  keterangan       String?
  status           StatusHutang  @default(belum)
  transaksiIdLunas String?
  transaksiLunas   Transaksi?    @relation("HutangLunas", fields: [transaksiIdLunas], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([arah, status])
  @@index([userId])
}

// Anggaran pengeluaran per kategori per bulan ("2026-09").
model Anggaran {
  id        String   @id @default(cuid())
  userId    String
  kategori  String
  batas     Int // Rupiah per bulan
  bulan     String // YYYY-MM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kategori, bulan])
  @@index([userId, bulan])
}
